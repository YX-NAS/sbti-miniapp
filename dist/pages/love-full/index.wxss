.love-full-page{background:linear-gradient(160deg,#fff3f1,#fff8f5 55%,#fffdf8);box-sizing:border-box;min-height:100vh;padding:40rpx 28rpx calc(56rpx + env(safe-area-inset-bottom))}.disclaimer-card,.intro-card,.question-card,.result-card{background:hsla(0,0%,100%,.94);border-radius:32rpx;box-shadow:0 12rpx 40rpx hsla(8,100%,74%,.08)}.intro-card{margin-top:100rpx;padding:64rpx 40rpx 48rpx;text-align:center}.intro-badge{background:hsla(8,100%,74%,.12);border-radius:999rpx;color:#ff8c7a;display:inline-block;font-size:24rpx;font-weight:700;margin-bottom:24rpx;padding:10rpx 22rpx}.intro-emoji{display:block;font-size:96rpx;margin-bottom:12rpx}.intro-title{color:#5f352f;display:block;font-size:44rpx;font-weight:800;margin-bottom:16rpx}.axis-range,.disclaimer-text,.guide-text,.intro-desc,.intro-note,.option-text,.result-summary{color:#7d6c69;font-size:28rpx;line-height:1.75}.intro-tags{display:flex;flex-wrap:wrap;gap:12rpx;justify-content:center;margin:28rpx 0 24rpx}.intro-tag{background:#fff2ef;border-radius:999rpx;color:#d06e5e;font-size:22rpx;padding:8rpx 18rpx}.intro-note{margin:0 0 32rpx}.next-btn.active,.start-btn{background:linear-gradient(135deg,#ff8c7a,#ffb09a);color:#fff}.start-btn{border-radius:46rpx;font-size:32rpx!important;font-weight:700!important;height:92rpx;line-height:92rpx;width:100%}.start-btn::after{border:none!important}.test-header{align-items:center;display:flex;justify-content:space-between;padding:12rpx 4rpx 20rpx}.header-title{color:#5f352f;font-size:34rpx;font-weight:800}.header-count{color:#b18c84;font-size:26rpx}.progress-bar{background:hsla(8,100%,74%,.12);border-radius:999rpx;height:10rpx;margin-bottom:24rpx;overflow:hidden}.progress-fill{background:linear-gradient(135deg,#ff8c7a,#ffb09a);height:100%}.question-scroll,.result-scroll{height:calc(100vh - 280rpx)}.question-card{margin-bottom:20rpx;padding:40rpx 32rpx}.question-note{color:#b18c84;display:block;font-size:24rpx;margin-bottom:12rpx}.question-text{color:#5f352f;font-size:40rpx;font-weight:700;line-height:1.55}.disclaimer-card{margin-bottom:20rpx;padding:24rpx 28rpx}.options-list{display:flex;flex-direction:column;gap:18rpx}.option-item{align-items:flex-start;background:hsla(0,0%,100%,.94);border:2rpx solid transparent;border-radius:28rpx;box-shadow:0 8rpx 24rpx hsla(8,100%,74%,.06);display:flex;gap:20rpx;padding:28rpx 26rpx}.option-item.selected{background:hsla(8,100%,74%,.08);border-color:#ff8c7a}.option-index{align-items:center;background:#fff2ef;border-radius:50%;color:#d06e5e;display:flex;flex-shrink:0;font-size:24rpx;font-weight:700;height:54rpx;justify-content:center;width:54rpx}.option-index.selected{background:#ff8c7a;color:#fff}.bottom-actions,.result-actions{display:flex;gap:20rpx;margin-top:24rpx}.back-btn,.next-btn,.secondary-btn{align-items:center;border-radius:44rpx;display:flex;font-size:30rpx;font-weight:700;height:88rpx;justify-content:center}.back-btn,.secondary-btn{background:hsla(0,0%,100%,.94);color:#8d726a;flex:1}.next-btn{flex:1.4}.next-btn.disabled{background:#f5e6e1;color:#c2a39c}.result-card{padding:52rpx 36rpx 44rpx}.result-label{color:#b18c84;display:block;font-size:24rpx;margin-bottom:14rpx;text-align:center}.result-title{color:#5f352f;display:block;font-size:48rpx;font-weight:800;margin-bottom:16rpx;text-align:center}.result-subtitle{color:#ff8c7a;display:block;font-size:28rpx;line-height:1.6;margin-bottom:20rpx;text-align:center}.axis-list{display:flex;flex-direction:column;gap:16rpx;margin:28rpx 0}.axis-card,.guide-card{background:#fff4f0;border-radius:24rpx;padding:22rpx 24rpx}.axis-head{display:flex;gap:20rpx;justify-content:space-between;margin-bottom:8rpx}.axis-name{color:#b18c84;font-size:24rpx}.axis-dominant{color:#ff8c7a;font-size:24rpx;font-weight:700}.guide-title{color:#6a463f;display:block;font-size:26rpx;font-weight:700;margin-bottom:8rpx}.result-note{color:#c9b4ad;display:block;font-size:22rpx;margin-top:28rpx;text-align:center}.share-result-btn{background:#ff8c7a;border:none;border-radius:44rpx;color:#fff;flex:1.4;font-size:30rpx;font-weight:700;height:88rpx;line-height:88rpx}.share-result-btn::after{border:none}.result-back-row{align-items:center;display:flex;justify-content:center;padding:20rpx 0 8rpx}.result-back-text{color:#ff8c7a;font-size:26rpx;text-decoration:underline}
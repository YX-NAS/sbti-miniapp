.char-full-page{background:linear-gradient(160deg,#fff1f7,#fff7fb 55%,#fffaf1);box-sizing:border-box;min-height:100vh;padding:40rpx 28rpx calc(56rpx + env(safe-area-inset-bottom))}.disclaimer-card,.intro-card,.question-card,.result-card{background:hsla(0,0%,100%,.94);border-radius:32rpx;box-shadow:0 12rpx 40rpx rgba(255,107,157,.08)}.intro-card{margin-top:100rpx;padding:64rpx 40rpx 48rpx;text-align:center}.intro-badge{background:rgba(255,107,157,.12);border-radius:999rpx;color:#ff6b9d;display:inline-block;font-size:24rpx;font-weight:700;margin-bottom:24rpx;padding:10rpx 22rpx}.intro-emoji{display:block;font-size:96rpx;margin-bottom:12rpx}.intro-title{color:#5a2440;display:block;font-size:44rpx;font-weight:800;margin-bottom:16rpx}.axis-range,.disclaimer-text,.guide-text,.intro-desc,.intro-note,.option-text,.result-summary{color:#776277;font-size:28rpx;line-height:1.75}.intro-tags{display:flex;flex-wrap:wrap;gap:12rpx;justify-content:center;margin:28rpx 0 24rpx}.intro-tag{background:#fff1f7;border-radius:999rpx;color:#c05885;font-size:22rpx;padding:8rpx 18rpx}.intro-note{margin:0 0 32rpx}.next-btn.active,.start-btn{background:linear-gradient(135deg,#ff6b9d,#ff8fb3);color:#fff}.start-btn{border-radius:46rpx;font-size:32rpx!important;font-weight:700!important;height:92rpx;line-height:92rpx;width:100%}.start-btn::after{border:none!important}.test-header{align-items:center;display:flex;justify-content:space-between;padding:12rpx 4rpx 20rpx}.header-title{color:#5a2440;font-size:34rpx;font-weight:800}.header-count{color:#b27b99;font-size:26rpx}.progress-bar{background:rgba(255,107,157,.12);border-radius:999rpx;height:10rpx;margin-bottom:24rpx;overflow:hidden}.progress-fill{background:linear-gradient(135deg,#ff6b9d,#ff8fb3);height:100%}.question-scroll,.result-scroll{height:calc(100vh - 280rpx)}.question-card{margin-bottom:20rpx;padding:40rpx 32rpx}.question-note{color:#b27b99;display:block;font-size:24rpx;margin-bottom:12rpx}.question-text{color:#5a2440;font-size:40rpx;font-weight:700;line-height:1.55}.disclaimer-card{margin-bottom:20rpx;padding:24rpx 28rpx}.options-list{display:flex;flex-direction:column;gap:18rpx}.option-item{align-items:flex-start;background:hsla(0,0%,100%,.94);border:2rpx solid transparent;border-radius:28rpx;box-shadow:0 8rpx 24rpx rgba(255,107,157,.06);display:flex;gap:20rpx;padding:28rpx 26rpx}.option-item.selected{background:rgba(255,107,157,.08);border-color:#ff6b9d}.option-index{align-items:center;background:#fff1f7;border-radius:50%;color:#c05885;display:flex;flex-shrink:0;font-size:24rpx;font-weight:700;height:54rpx;justify-content:center;width:54rpx}.option-index.selected{background:#ff6b9d;color:#fff}.bottom-actions,.result-actions{display:flex;gap:20rpx;margin-top:24rpx}.back-btn,.next-btn,.secondary-btn{align-items:center;border-radius:44rpx;display:flex;font-size:30rpx;font-weight:700;height:88rpx;justify-content:center}.back-btn,.secondary-btn{background:hsla(0,0%,100%,.94);color:#7e6680;flex:1}.next-btn{flex:1.4}.next-btn.disabled{background:#f0e2ea;color:#bc9db0}.result-card{padding:52rpx 36rpx 44rpx}.result-label{color:#b27b99;display:block;font-size:24rpx;margin-bottom:14rpx;text-align:center}.result-title{color:#5a2440;display:block;font-size:48rpx;font-weight:800;margin-bottom:16rpx;text-align:center}.result-subtitle{color:#ff6b9d;display:block;font-size:28rpx;line-height:1.6;margin-bottom:20rpx;text-align:center}.axis-list{display:flex;flex-direction:column;gap:16rpx;margin:28rpx 0}.axis-card,.guide-card{background:#fff3f8;border-radius:24rpx;padding:22rpx 24rpx}.axis-head{display:flex;gap:20rpx;justify-content:space-between;margin-bottom:8rpx}.axis-name{color:#b27b99;font-size:24rpx}.axis-dominant{color:#ff6b9d;font-size:24rpx;font-weight:700}.guide-title{color:#6d3650;display:block;font-size:26rpx;font-weight:700;margin-bottom:8rpx}.result-note{color:#c3b0bd;display:block;font-size:22rpx;margin-top:28rpx;text-align:center}.share-result-btn{background:#ff6b9d;border:none;border-radius:44rpx;color:#fff;flex:1.4;font-size:30rpx;font-weight:700;height:88rpx;line-height:88rpx}.share-result-btn::after{border:none}.result-back-row{align-items:center;display:flex;justify-content:center;padding:20rpx 0 8rpx}.result-back-text{color:#ff6b9d;font-size:26rpx;text-decoration:underline}
.match-container{background:linear-gradient(160deg,#e5f3ff,#fff0e5 50%,#f0fff0);min-height:100vh;overflow:hidden;padding-bottom:40rpx;position:relative}.top-decor{height:400rpx;left:0;pointer-events:none;position:absolute;right:0;top:0}.top-decor .decor-circle{border-radius:50%;position:absolute}.top-decor .c1{background:#4d96ff;height:240rpx;opacity:.25;right:-60rpx;top:-60rpx;width:240rpx}.top-decor .c2{background:#ffd93d;height:200rpx;left:-80rpx;opacity:.2;top:80rpx;width:200rpx}.top-decor .c3{background:#6bcb77;height:120rpx;opacity:.18;right:40rpx;top:160rpx;width:120rpx}.page-header{padding:120rpx 48rpx 32rpx;position:relative;text-align:center;z-index:1}.page-header .page-title{color:#5a4a4a;display:block;font-size:48rpx;font-weight:800;letter-spacing:2rpx;margin-bottom:16rpx}.page-header .page-subtitle{color:#7a5a6a;display:block;font-size:28rpx;letter-spacing:1rpx}.select-section{align-items:center;display:flex;gap:24rpx;justify-content:center;margin-bottom:16rpx;padding:0 32rpx;position:relative;z-index:1}.select-card{backdrop-filter:blur(8rpx);background:hsla(0,0%,100%,.85);border-radius:24rpx;box-shadow:0 8rpx 24rpx rgba(0,0,0,.08);flex:1;max-width:220rpx;padding:24rpx 20rpx;text-align:center}.select-card .select-label{color:#7a5a6a;display:block;font-size:24rpx;letter-spacing:1rpx;margin-bottom:16rpx}.select-card .sign-picked{align-items:center;display:flex;flex-direction:column;gap:8rpx}.select-card .sign-picked .sign-emoji{font-size:48rpx;line-height:1}.select-card .sign-picked .sign-name{color:#5a4a4a;font-size:30rpx;font-weight:700}.select-divider{align-items:center;display:flex;justify-content:center}.select-divider .plus-icon{color:#4d96ff;font-size:40rpx;font-weight:700}.sign-selector-wrap{backdrop-filter:blur(8rpx);background:hsla(0,0%,100%,.6);border-radius:24rpx;box-shadow:0 4rpx 16rpx rgba(0,0,0,.06);margin:12rpx 24rpx;position:relative;z-index:1}.sign-selector-wrap .selector-hint{color:#7a5a6a;display:block;font-size:26rpx;letter-spacing:1rpx;padding:20rpx 24rpx 0}.match-btn-wrap{padding:24rpx 48rpx;position:relative;z-index:1}.match-btn{background:linear-gradient(135deg,#4d96ff,#6bcb77)!important;border:none!important;border-radius:50rpx!important;box-shadow:0 8rpx 32rpx rgba(77,150,255,.35)!important;color:#fff!important;font-size:38rpx!important;font-weight:700!important;height:100rpx!important;letter-spacing:3rpx;line-height:100rpx!important;width:100%!important}.match-btn::after{border:none!important}.match-btn:active{transform:scale(.97)}.result-section{animation:slideUp .4s ease-out;padding:0 32rpx;position:relative;z-index:1}@keyframes slideUp{from{opacity:0;transform:translateY(40rpx)}to{opacity:1;transform:translateY(0)}}.result-card{backdrop-filter:blur(12rpx);background:hsla(0,0%,100%,.92);border-radius:32rpx;box-shadow:0 16rpx 48rpx rgba(0,0,0,.1);overflow:hidden;padding:48rpx 36rpx 40rpx;position:relative}.result-card .result-decor{border-radius:50%;position:absolute}.result-card .result-decor.decor-left{background:#4d96ff;bottom:-60rpx;height:200rpx;left:-60rpx;opacity:.12;width:200rpx}.result-card .result-decor.decor-right{background:#6bcb77;height:160rpx;opacity:.1;right:-40rpx;top:-40rpx;width:160rpx}.score-area{align-items:center;display:flex;flex-direction:column;margin-bottom:32rpx;position:relative;z-index:1}.score-area .signs-combo{align-items:center;display:flex;gap:16rpx;margin-bottom:24rpx}.score-area .signs-combo .combo-emoji{font-size:52rpx}.score-area .signs-combo .combo-plus{color:#7a5a6a;font-size:36rpx;font-weight:700}.score-area .score-circle{align-items:center;border:8rpx solid;border-radius:50%;display:flex;flex-direction:column;height:200rpx;justify-content:center;margin-bottom:20rpx;width:200rpx}.score-area .score-circle .score-num{font-size:96rpx;font-weight:800;line-height:1}.score-area .score-circle .score-percent{font-size:36rpx;font-weight:700}.score-area .match-type-label{font-size:36rpx;font-weight:700;letter-spacing:2rpx}.result-summary{background:rgba(77,1
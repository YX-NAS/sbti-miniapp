.sign-selector{display:grid;gap:16rpx;grid-template-columns:repeat(4,1fr);padding:24rpx}.sign-selector .sign-item{align-items:center;background:hsla(0,0%,100%,.8);border:2rpx solid transparent;border-radius:20rpx;display:flex;flex-direction:column;height:96rpx;justify-content:center;transition:all .2s ease}.sign-selector .sign-item:active{transform:scale(.95)}.sign-selector .sign-item.selected{background:rgba(255,107,157,.1);border-color:#ff6b9d;box-shadow:0 4rpx 16rpx rgba(255,107,157,.2)}.sign-selector .sign-item .sign-emoji{font-size:36rpx;line-height:1;margin-bottom:8rpx}.sign-selector .sign-item .sign-name{color:#5a4a4a;font-size:22rpx;letter-spacing:1rpx}.sign-selector .sign-item.selected .sign-name{color:#ff6b9d;font-weight:600}.bottom-nav{align-items:center;backdrop-filter:blur(12rpx);-webkit-backdrop-filter:blur(12rpx);background:hsla(0,0%,100%,.95);border-top:2rpx solid rgba(0,0,0,.05);bottom:0;box-shadow:0 -4rpx 24rpx rgba(0,0,0,.04);display:flex;justify-content:space-around;left:0;padding:16rpx 16rpx calc(12rpx + env(safe-area-inset-bottom));position:fixed;right:0;z-index:100}.bottom-nav .nav-item{align-items:center;border-radius:20rpx;display:flex;flex-direction:column;gap:6rpx;min-width:120rpx;padding:8rpx 20rpx}.bottom-nav .nav-item .nav-icon{font-size:40rpx}.bottom-nav .nav-item .nav-label{color:#666;font-size:20rpx}
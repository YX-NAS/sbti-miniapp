.catti-page{background:linear-gradient(160deg,#f5f0ff,#fff0fa 55%,#fdf8ef);box-sizing:border-box;min-height:100vh;padding:40rpx 28rpx calc(56rpx + env(safe-area-inset-bottom))}.intro-card{background:hsla(0,0%,100%,.92);border-radius:32rpx;box-shadow:0 12rpx 40rpx rgba(156,123,255,.12);margin-top:80rpx;padding:60rpx 40rpx 48rpx;text-align:center}.intro-emoji{display:block;font-size:96rpx;margin-bottom:8rpx}.intro-badge{background:rgba(156,123,255,.12);border-radius:999rpx;color:#9c7bff;display:inline-block;font-size:24rpx;font-weight:700;margin-bottom:20rpx;padding:10rpx 24rpx}.intro-title{color:#2d1f5e;display:block;font-size:44rpx;font-weight:800;margin-bottom:16rpx}.intro-desc{color:#7a6aaa;display:block;font-size:28rpx;line-height:1.7;margin-bottom:8rpx}.intro-note{color:#aaa;display:block;font-size:24rpx;margin-bottom:32rpx}.intro-dims{display:flex;flex-wrap:wrap;gap:12rpx;justify-content:center;margin-bottom:40rpx}.dim-tag{align-items:center;background:rgba(156,123,255,.08);border-radius:16rpx;display:flex;flex-direction:column;min-width:120rpx;padding:14rpx 20rpx}.dim-label{color:#9c7bff;font-size:26rpx;font-weight:700}.dim-desc{color:#7a6aaa;font-size:20rpx;margin-top:4rpx}.intro-btn{align-items:center;border-radius:48rpx;display:flex;height:96rpx;justify-content:center;margin-bottom:20rpx;width:100%}.intro-btn-text{color:#fff;font-size:32rpx;font-weight:700}.intro-share-btn{background:rgba(156,123,255,.1);border:none;border-radius:48rpx;color:#9c7bff;font-size:28rpx;font-weight:600;height:80rpx;line-height:80rpx;width:100%}.intro-share-btn::after{border:none}.q-header{margin-bottom:24rpx}.q-progress-bar{background:rgba(156,123,255,.15);border-radius:4rpx;height:8rpx;margin-bottom:12rpx;overflow:hidden}.q-progress-fill{border-radius:4rpx;height:100%;transition:width .3s ease}.q-counter{color:#9c7bff;display:block;font-size:24rpx;font-weight:600;text-align:right}.q-card{background:hsla(0,0%,100%,.92);border-radius:28rpx;box-shadow:0 8rpx 32rpx rgba(156,123,255,.08);margin-bottom:24rpx;padding:40rpx 32rpx}.q-hint-wrap{background:rgba(156,123,255,.1);border-radius:999rpx;display:inline-block;margin-bottom:20rpx;padding:8rpx 20rpx}.q-hint{color:#9c7bff;font-size:24rpx;font-weight:600}.q-text{color:#2d1f5e;display:block;font-size:34rpx;font-weight:700;line-height:1.6}.options-area{display:flex;flex-direction:column;gap:16rpx;margin-bottom:32rpx}.option-item{align-items:center;background:hsla(0,0%,100%,.92);border:2rpx solid rgba(156,123,255,.15);border-radius:20rpx;box-shadow:0 4rpx 16rpx rgba(156,123,255,.06);display:flex;padding:24rpx 20rpx;transition:all .15s ease}.option-item.selected{box-shadow:0 6rpx 24rpx rgba(156,123,255,.16)}.opt-key{align-items:center;background:rgba(156,123,255,.1);border-radius:50%;display:flex;flex-shrink:0;height:56rpx;justify-content:center;margin-right:20rpx;width:56rpx}.opt-key-text{color:#9c7bff;font-size:26rpx;font-weight:700}.opt-text{color:#3d2e6a;flex:1;font-size:28rpx;line-height:1.5}.opt-check{font-size:28rpx;font-weight:700;margin-left:12rpx}.bottom-area{padding:0 0 16rpx}.next-btn{align-items:center;border-radius:48rpx;display:flex;height:96rpx;justify-content:center}.next-btn.disabled{background:rgba(156,123,255,.2)}.next-btn-text{color:#fff;font-size:32rpx;font-weight:700}.disabled .next-btn-text{color:rgba(156,123,255,.7)}.result-card{background:hsla(0,0%,100%,.95);border-radius:32rpx;box-shadow:0 16rpx 48rpx rgba(156,123,255,.12);padding:48rpx 36rpx}.result-header{align-items:center;display:flex;justify-content:space-between;margin-bottom:32rpx}.result-tag{background:rgba(156,123,255,.1);border-radius:999rpx;color:#9c7bff;font-size:24rpx;font-weight:700;padding:8rpx 20rpx}.result-type-code{color:#9c7bff;font-size:36rpx;font-weight:900;letter-spacing:4rpx}.result-emoji{display:block;font-size:96rpx;margin-bottom:12rpx;text-align:center}.result-name{color:#2d1f5e;display:block;font-size:38rpx;font-weight:800;line-height:1.4;margin-bottom:8rpx;text-align:center}.result-subname{color:#9c7bff;display:block;font-size:26rpx;font-weight:600;margin-bottom:32rpx;text-align:center}.result-quote-wrap{background:rgba(156,123,255,.06);border-left:4rpx solid #9c7bff;border-radius:0 16rpx 16rpx 0;margin-bottom:28rpx;padding:24rpx 28rpx}.result-quote{color:#3d2e6a;font-size:28rpx;font-style:italic;line-height:1.7}.result-traits{display:flex;flex-wrap:wrap;gap:12rpx;margin-bottom:28rpx}.trait-tag{background:rgba(156,123,255,.1);border-radius:999rpx;padding:10rpx 22rpx}.trait-text{color:#9c7bff;font-size:24rpx;font-weight:600}.result-desc{color:#4a3a7a;display:block;font-size:28rpx;line-height:1.85;margin-bottom:16rpx}.result-note{color:#bbb;display:block;font-size:22rpx;margin-bottom:36rpx;text-align:center}.result-actions{display:flex;gap:16rpx;margin-bottom:20rpx}.result-retest-btn{align-items:center;background:rgba(156,123,255,.1);border-radius:42rpx;color:#9c7bff;display:flex;flex:1;font-size:28rpx;font-weight:600;height:84rpx;justify-content:center}.result-share-btn{border:none;border-radius:42rpx;color:#fff;flex:1.5;font-size:28rpx;font-weight:700;height:84rpx;line-height:84rpx}.result-share-btn::after{border:none}.result-back-btn{align-items:center;display:flex;justify-content:center;padding:16rpx}.result-back-text{color:#9c7bff;font-size:26rpx;text-decoration:underline}
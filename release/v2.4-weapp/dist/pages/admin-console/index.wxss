er-bottom:1rpx solid rgba(80,89,140,.08);padding:16rpx 0}.analytics-item:last-child{border-bottom:none}.analytics-name{color:#36405f;display:block;font-size:26rpx;font-weight:700;margin-bottom:6rpx}.analytics-meta{color:#7d85a4;display:block;font-size:22rpx}.footer-actions{justify-content:center;margin-top:12rpx}.funnel-card{background:rgba(91,124,250,.06);border-radius:20rpx;margin-bottom:16rpx;padding:24rpx 20rpx}.funnel-type{color:#36405f;display:block;font-size:26rpx;font-weight:700;margin-bottom:16rpx}.funnel-row{align-items:center;display:flex;justify-content:space-between}.funnel-col{align-items:center;display:flex;flex:1;flex-direction:column}.funnel-num{color:#5b7cfa;font-size:36rpx;font-weight:800}.funnel-label{color:#7d85a4;font-size:20rpx;margin-top:4rpx}.funnel-rate{color:#6bcb77;font-size:22rpx;font-weight:700;margin-top:4rpx}.funnel-arrow{color:#b0b8d8;flex-shrink:0;font-size:24rpx;padding:0 4rpx}.ops-card{background:rgba(108,142,239,.06);border-radius:20rpx;margin-top:16rpx;padding:22rpx 20rpx}.ops-title{color:#36405f;display:block;font-size:26rpx;font-weight:700;margin-bottom:14rpx}.ops-row{border-bottom:1rpx solid rgba(80,89,140,.08);display:flex;gap:16rpx;justify-content:space-between;padding:10rpx 0}.ops-row:last-of-type{border-bottom:none}.ops-name{color:#4c5674;font-size:24rpx}.ops-tag{color:#5b7cfa;font-size:22rpx;font-weight:700}
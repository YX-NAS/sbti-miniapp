.daily-container{background:linear-gradient(160deg,#fff8f0,#fff3e6 40%,#fff0f5);min-height:100vh;padding-bottom:40rpx}.date-header{align-items:center;display:flex;justify-content:space-between;padding:48rpx 32rpx 24rpx;position:relative;z-index:1}.date-header .date-tag{background:rgba(255,200,80,.2);border-radius:20rpx;padding:8rpx 20rpx}.date-header .date-tag .date-text{color:#b07800;font-size:26rpx;font-weight:700;letter-spacing:1rpx}.date-header .type-tag{align-items:center;background:rgba(255,140,50,.15);border-radius:20rpx;display:flex;gap:6rpx;padding:8rpx 16rpx}.date-header .type-tag .type-emoji{font-size:24rpx}.date-header .type-tag .type-text{color:#d07000;font-size:26rpx;font-weight:700;letter-spacing:1rpx}.progress-bar{align-items:center;display:flex;gap:12rpx;margin-bottom:24rpx;padding:0 32rpx;position:relative;z-index:1}.progress-bar .progress-fill{background:rgba(255,140,50,.3);border-radius:3rpx;flex:1;height:6rpx;overflow:hidden}.progress-bar .progress-fill::after{background:linear-gradient(90deg,#ff8c32,#ffb800);border-radius:3rpx;content:"";display:block;height:100%;width:100%}.progress-bar .progress-text{color:#b07800;font-size:24rpx;font-weight:600;white-space:nowrap}.question-card{backdrop-filter:blur(10rpx);background:hsla(0,0%,100%,.88);border-radius:28rpx;box-shadow:0 8rpx 32rpx rgba(255,140,50,.1);margin:0 32rpx 24rpx;padding:40rpx 36rpx;position:relative;z-index:1}.question-card .question-decor{background:linear-gradient(135deg,#ffb800,#ff8c32);border-radius:50%;height:60rpx;opacity:.15;position:absolute;right:30rpx;top:-15rpx;width:60rpx}.question-card .question-text{color:#3a2a1a;display:block;font-size:38rpx;font-weight:700;letter-spacing:1rpx;line-height:1.7;position:relative;z-index:1}.options-area{display:flex;flex-direction:column;gap:16rpx;margin-bottom:24rpx;padding:0 32rpx;position:relative;z-index:1}.option-item{align-items:center;backdrop-filter:blur(8rpx);background:hsla(0,0%,100%,.85);border:2rpx solid transparent;border-radius:20rpx;box-shadow:0 4rpx 16rpx rgba(0,0,0,.04);display:flex;gap:16rpx;padding:22rpx 24rpx;position:relative;transition:all .25s ease}.option-item.selected{background:rgba(255,140,50,.08);border-color:rgba(255,140,50,.4)}.option-item.selected .option-label{background:linear-gradient(135deg,#ff8c32,#ffb800);color:#fff}.option-item.correct{background:rgba(255,140,50,.08);border-color:rgba(255,140,50,.4)}.option-item.dim{opacity:.45}.option-item .option-label{align-items:center;background:rgba(0,0,0,.05);border-radius:50%;color:#7a5a4a;display:flex;flex-shrink:0;font-size:28rpx;font-weight:800;height:48rpx;justify-content:center;transition:all .25s ease;width:48rpx}.option-item .option-text{color:#4a3a2a;flex:1;font-size:30rpx;font-weight:600;line-height:1.6}.option-item .check-mark{align-items:center;background:linear-gradient(135deg,#ff8c32,#ffb800);border-radius:50%;color:#fff;display:flex;flex-shrink:0;font-size:24rpx;height:36rpx;justify-content:center;width:36rpx}.submit-area{margin-bottom:32rpx;padding:0 32rpx;position:relative;z-index:1}.submit-btn{align-items:center;border-radius:48rpx;display:flex;height:96rpx;justify-content:center;transition:all .3s ease}.submit-btn.active{background:linear-gradient(135deg,#ff8c32,#ffb800);box-shadow:0 8rpx 32rpx rgba(255,140,50,.35)}.submit-btn.active .submit-text{color:#fff}.submit-btn.disabled{background:rgba(0,0,0,.05)}.submit-btn.disabled .submit-text{color:#b0a0a0}.submit-btn .submit-text{font-size:34rpx;font-weight:800;letter-spacing:3rpx}.result-area{animation:slideUp .4s ease-out;padding:0 32rpx}@keyframes slideUp{from{opacity:0;transform:translateY(40rpx)}to{opacity:1;transform:translateY(0)}}.result-card{backdrop-filter:blur(12rpx);background:hsla(0,0%,100%,.92);border-radius:32rpx;box-shadow:0 16rpx 48rpx rgba(255,140,50,.12);overflow:hidden;padding:40rpx 36rpx 36rpx;position:relative;text-align:center}.result-card .result-decor{background:#ffb800;border-radius:50%;bottom:-80rpx;height:240rpx;left:-80rpx;opacity:.1;position:absolute;width:240rpx}.result-header{align-items:center;display:flex;flex-direction:column;margin-bottom:24rpx;position:relative;z-index:1}.result-header .result-emoji{animation:bounce .6s ease-out;font-size:64rpx;margin-bottom:12rpx}.result-header .result-title{color:#3a2a1a;font-size:44rpx;font-weight:800;letter-spacing:2rpx}@keyframes bounce{0%{opacity:0;transform:scale(.5)}60%{transform:scale(1.2)}100%{opacity:1;transform:scale(1)}}.result-desc{background:rgba(255,140,50,.06);border:1rpx solid rgba(255,140,50,.1);border-radius:20rpx;margin-bottom:28rpx;padding:24rpx;position:relative;z-index:1}.result-desc .result-desc-text{color:#5a4a3a;display:block;font-size:28rpx;line-height:1.9}.result-tags{display:flex;gap:24rpx;justify-content:center;margin-bottom:28rpx;position:relative;z-index:1}.result-tags .result-tag{align-items:center;background:rgba(255,140,50,.08);border-radius:16rpx;display:flex;gap:6rpx;padding:10rpx 18rpx}.result-tags .result-tag .tag-icon{font-size:22rpx}.result-tags .result-tag .tag-text{color:#b07800;font-size:26rpx;font-weight:700}.re-test-btn{align-items:center;background:rgba(0,0,0,.04);border-radius:40rpx;display:flex;height:80rpx;justify-content:center;margin-bottom:20rpx;position:relative;z-index:1}.re-test-btn .re-test-text{color:#7a5a4a;font-size:30rpx;font-weight:700;letter-spacing:2rpx}.re-test-btn:active{background:rgba(0,0,0,.08)}.share-hint{position:relative;z-index:1}.share-hint .share-hint-text{color:#9a8a7a;font-size:24rpx;letter-spacing:1rpx}.bottom-spacer{height:60rpx}
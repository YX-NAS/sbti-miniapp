.test-type-container{background:linear-gradient(160deg,#f8faff,#eef2ff 50%,#f6f0ff);min-height:100vh;padding-bottom:60rpx}.page-header{padding:80rpx 40rpx 32rpx;text-align:center}.page-header .header-action-row{align-items:center;display:flex;justify-content:space-between;margin-bottom:20rpx}.page-header .admin-btn,.page-header .home-btn{align-items:center;background:hsla(0,0%,100%,.9);border-radius:30rpx;box-shadow:0 6rpx 18rpx rgba(80,89,140,.08);display:inline-flex;height:60rpx;justify-content:center;padding:0 24rpx}.page-header .admin-btn-text,.page-header .home-btn-text{color:#4e5c9a;font-size:24rpx;font-weight:700}.page-header .header-action-placeholder{height:60rpx;width:160rpx}.page-header .page-title{color:#2a2a3a;display:block;font-size:52rpx;font-weight:800;letter-spacing:2rpx;margin-bottom:12rpx}.insight-strip,.resume-list{padding:0 28rpx}.streak-card{align-items:center;background:hsla(0,0%,100%,.9);border-radius:24rpx;box-shadow:0 6rpx 18rpx rgba(80,89,140,.08);display:flex;gap:18rpx;margin-bottom:24rpx;padding:24rpx}.streak-num{align-items:center;background:linear-gradient(135deg,#6c8eef,#8f74ff);border-radius:50%;color:#fff;display:flex;flex-shrink:0;font-size:42rpx;font-weight:800;height:108rpx;justify-content:center;width:108rpx}.streak-copy{display:flex;flex-direction:column}.streak-title{color:#2a2a3a;font-size:30rpx;font-weight:800;margin-bottom:6rpx}.streak-desc{color:#6a6a8a;font-size:24rpx;line-height:1.6}.resume-list{display:flex;flex-direction:column;gap:16rpx;margin-bottom:24rpx}.resume-card{background:hsla(0,0%,100%,.92);border-radius:24rpx;box-shadow:0 4rpx 20rpx rgba(0,0,0,.04);padding:24rpx}.resume-top{align-items:center;display:flex;justify-content:space-between;margin-bottom:10rpx}.resume-emoji{font-size:36rpx}.resume-progress{color:#7a7a9a;font-size:22rpx}.resume-title{color:#2a2a3a;display:block;font-size:28rpx;font-weight:700;margin-bottom:14rpx}.resume-bar{background:#eef1fa;border-radius:6rpx;height:10rpx;margin-bottom:12rpx;overflow:hidden}.resume-fill{border-radius:6rpx;height:100%}.resume-cta{font-size:24rpx;font-weight:700}.section-title-row{align-items:baseline;display:flex;justify-content:flex-start;padding:12rpx 32rpx 18rpx}.section-title-row .section-title{color:#2a2a3a;font-size:30rpx;font-weight:800}.test-grid{display:flex;flex-direction:column;gap:20rpx;margin-bottom:24rpx;padding:0 28rpx}.test-card{backdrop-filter:blur(10rpx);background:hsla(0,0%,100%,.85);border:1.5rpx solid;border-radius:24rpx;box-shadow:0 4rpx 20rpx rgba(0,0,0,.04);padding:28rpx 28rpx 24rpx}.test-card .card-top{align-items:flex-start;display:flex;justify-content:space-between;margin-bottom:14rpx}.test-card .card-top .card-emoji{font-size:44rpx}.test-card .card-title{display:block;font-size:36rpx;font-weight:800;letter-spacing:1rpx;margin-bottom:8rpx}.test-card .card-desc{color:#6a6a8a;display:block;font-size:26rpx;line-height:1.6;margin-bottom:18rpx}.test-card .card-btn{align-items:center;border-radius:32rpx;display:flex;height:64rpx;justify-content:center;opacity:.9}.test-card .card-btn .card-btn-text{color:#fff;font-size:28rpx;font-weight:700;letter-spacing:2rpx}.available-tag{background:hsla(0,0%,100%,.75);border-radius:12rpx;padding:4rpx 12rpx}.available-tag .available-text{color:#5a5a7a;font-size:22rpx;font-weight:600;letter-spacing:1rpx}
.cp-container{background:linear-gradient(160deg,#fff0f5,#ffe4ec 40%,#fff5f8);min-height:100vh;overflow:hidden;padding-bottom:40rpx;position:relative}.top-decor{height:300rpx;left:0;pointer-events:none;position:absolute;right:0;top:0}.top-decor .heart{font-size:32rpx;opacity:.6;position:absolute}.top-decor .heart.heart-1{animation:float 3s ease-in-out infinite;font-size:40rpx;right:30rpx;top:20rpx}.top-decor .heart.heart-2{animation:float 4s ease-in-out .5s infinite;font-size:28rpx;left:20rpx;top:80rpx}.top-decor .heart.heart-3{animation:float 3.5s ease-in-out 1s infinite;font-size:24rpx;right:100rpx;top:50rpx}@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-10rpx)}}.page-header{padding:100rpx 48rpx 24rpx;position:relative;text-align:center;z-index:1}.page-header .page-title{color:#5a4a4a;display:block;font-size:52rpx;font-weight:800;letter-spacing:2rpx;margin-bottom:12rpx}.page-header .page-subtitle{color:#7a5a6a;display:block;font-size:28rpx;letter-spacing:1rpx}.select-section{align-items:center;display:flex;gap:16rpx;justify-content:center;margin-bottom:12rpx;padding:0 32rpx;position:relative;z-index:1}.select-card{backdrop-filter:blur(8rpx);background:hsla(0,0%,100%,.9);border:2rpx solid transparent;border-radius:24rpx;box-shadow:0 8rpx 24rpx rgba(255,107,157,.15);flex:1;max-width:200rpx;padding:20rpx 16rpx;text-align:center}.select-card.boy{border-color:rgba(77,150,255,.2)}.select-card.girl{border-color:rgba(255,107,157,.2)}.select-card .select-label{color:#7a5a6a;display:block;font-size:24rpx;letter-spacing:1rpx;margin-bottom:12rpx}.select-card .sign-picked{align-items:center;display:flex;flex-direction:column;gap:6rpx}.select-card .sign-picked .sign-emoji{font-size:40rpx;line-height:1}.select-card .sign-picked .sign-name{color:#5a4a4a;font-size:28rpx;font-weight:700}.heart-center{align-items:center;display:flex;justify-content:center}.heart-center .heart-icon{animation:pulse 1.5s ease-in-out infinite;font-size:36rpx}@keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.2)}}.sign-selector-wrap{backdrop-filter:blur(8rpx);background:hsla(0,0%,100%,.65);border-radius:24rpx;box-shadow:0 4rpx 16rpx rgba(0,0,0,.05);margin:12rpx 24rpx;position:relative;z-index:1}.sign-selector-wrap .selector-hint{color:#7a5a6a;display:block;font-size:26rpx;letter-spacing:1rpx;padding:16rpx 24rpx 0}.match-btn-wrap{padding:20rpx 48rpx;position:relative;z-index:1}.match-btn{background:linear-gradient(135deg,#ff6b9d,#ff8e8e)!important;border:none!important;border-radius:48rpx!important;box-shadow:0 8rpx 32rpx rgba(255,107,157,.4)!important;color:#fff!important;font-size:38rpx!important;font-weight:700!important;height:96rpx!important;letter-spacing:3rpx;line-height:96rpx!important;width:100%!important}.match-btn::after{border:none!important}.match-btn:active{transform:scale(.97)}.result-section{animation:slideUp .4s ease-out;padding:0 32rpx;position:relative;z-index:1}@keyframes slideUp{from{opacity:0;transform:translateY(40rpx)}to{opacity:1;transform:translateY(0)}}.result-card{backdrop-filter:blur(12rpx);background:hsla(0,0%,100%,.92);border-radius:32rpx;box-shadow:0 16rpx 48rpx rgba(255,107,157,.15);overflow:hidden;padding:40rpx 32rpx 36rpx;position:relative}.result-card .result-decor{border-radius:50%;position:absolute}.result-card .result-decor.decor-1{background:#ff6b9d;bottom:-80rpx;height:240rpx;left:-80rpx;opacity:.1;width:240rpx}.result-card .result-decor.decor-2{background:#ffb6c1;height:200rpx;opacity:.12;right:-60rpx;top:-60rpx;width:200rpx}.cp-header{align-items:center;display:flex;flex-direction:column;margin-bottom:24rpx;position:relative;z-index:1}.cp-header .cp-names{font-size:48rpx;letter-spacing:8rpx;margin-bottom:8rpx}.cp-header .cp-name{font-size:36rpx;font-weight:700;letter-spacing:2rpx}.score-area{align-items:center;display:flex;flex-direction:column;margin-bottom:28rpx;position:relative;z-index:1}.score-area .score-circle{align-items:center;border:6rpx solid;border-radius:50%;display:flex;flex-direction:column;height:180rpx;justify-content:center;margin-bottom:12rpx;width:180rpx}.score-area .score-circle .score-num{font-size:80rpx;font-weight:800;line-height:1}.score-area .score-circle .score-unit{font-size:28rpx;font-weight:700}.score-area .score-label{font-size:32rpx;font-weight:700;letter-spacing:2rpx;margin-bottom:4rpx}.score-area .score-level{color:#7a5a6a;font-size:26rpx;letter-spacing:1rpx}.story-section{background:rgba(255,107,157,.06);border:1rpx solid rgba(255,107,157,.12);border-radius:16rpx;margin-bottom:20rpx;padding:20rpx 24rpx;position:relative;z-index:1}.story-section .story-title{color:#ff6b9d;display:block;font-size:28rpx;font-weight:700;letter-spacing:1rpx;margin-bottom:10rpx}.story-section .story-text{color:#5a4a4a;display:block;font-size:26rpx;font-style:italic;line-height:1.8}.summary-bubble{background:hsla(0,100%,78%,.08);border-radius:16rpx;margin-bottom:24rpx;padding:18rpx 24rpx;position:relative;z-index:1}.summary-bubble .summary-text{color:#5a4a4a;display:block;font-size:28rpx;font-style:italic;line-height:1.8;text-align:center}.advice-section{display:flex;flex-direction:column;gap:20rpx;margin-bottom:32rpx;position:relative;z-index:1}.advice-section .advice-block{background:rgba(0,0,0,.03);border-radius:20rpx;padding:20rpx 24rpx}.advice-section .advice-header{align-items:center;display:flex;gap:10rpx;margin-bottom:14rpx}.advice-section .advice-header .advice-icon{font-size:26rpx}.advice-section .advice-header .advice-title{color:#5a4a4a;font-size:30rpx;font-weight:700;letter-spacing:1rpx}.advice-section .advice-item{display:flex;gap:10rpx;margin-bottom:8rpx}.advice-section .advice-item:last-child{margin-bottom:0}.advice-section .advice-item .advice-bullet{color:#ff6b9d;flex-shrink:0;font-size:26rpx;line-height:1.6}.advice-section .advice-item .advice-text{color:#7a5a6a;font-size:26rpx;line-height:1.6}.action-btns{display:flex;gap:16rpx;position:relative;z-index:1}.action-btns .share-btn{background:linear-gradient(135deg,#ff6b9d,#ff8e8e)!important;border:none!important;border-radius:42rpx!important;box-shadow:0 6rpx 20rpx rgba(255,107,157,.3)!important;color:#fff!important;flex:1;font-size:30rpx!important;font-weight:700!important;height:84rpx!important;letter-spacing:2rpx;line-height:84rpx!important}.action-btns .share-btn::after{border:none!important}.action-btns .share-btn:active{transform:scale(.97)}.action-btns .reset-btn{background:hsla(0,0%,100%,.9)!important;border:2rpx solid rgba(0,0,0,.08)!important;border-radius:42rpx!important;color:#7a5a6a!important;flex:1;font-size:30rpx!important;font-weight:600!important;height:84rpx!important;letter-spacing:2rpx;line-height:84rpx!important}.action-btns .reset-btn::after{border:none!important}.action-btns .reset-btn:active{transform:scale(.97)}.bottom-spacer{height:60rpx}
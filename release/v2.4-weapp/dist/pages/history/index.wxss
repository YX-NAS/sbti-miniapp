mpty-go-btn{background:#6c8d71;border-radius:48rpx;padding:24rpx 64rpx}.empty-go-text{color:#fff;font-size:30rpx;font-weight:700}.history-list{flex:1;padding:0 24rpx}.history-item{align-items:center;background:#fff;border-radius:24rpx;box-shadow:0 4rpx 20rpx rgba(0,0,0,.05);display:flex;margin-bottom:16rpx;padding:24rpx 20rpx}.item-emoji-wrap{align-items:center;border-radius:20rpx;display:flex;flex-shrink:0;height:80rpx;justify-content:center;margin-right:20rpx;width:80rpx}.item-emoji{font-size:40rpx}.item-content{flex:1;min-width:0}.item-title{color:#1a2e1c;display:block;font-size:28rpx;font-weight:700;margin-bottom:10rpx}.item-meta{align-items:center;display:flex;gap:12rpx;margin-bottom:8rpx}.item-code-tag{border-radius:999rpx;flex-shrink:0;padding:4rpx 14rpx}.item-code{font-size:22rpx;font-weight:700;letter-spacing:1rpx}.item-summary{color:#7a9e7f;flex:1;font-size:24rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.item-time{color:#b0c8b3;display:block;font-size:22rpx}.item-arrow{font-size:40rpx;font-weight:700;margin-left:12rpx}.history-footer{padding:24rpx 0 40rpx;text-align:center}.footer-note{color:#c5d8c7;font-size:22rpx}.recommend-wrap{padding-bottom:32rpx}.recommend-title{color:#1a2e1c;display:block;font-size:28rpx;font-weight:800;padding:0 4rpx 16rpx}.recommend-card{align-items:center;background:#fff;border-radius:24rpx;box-shadow:0 4rpx 20rpx rgba(0,0,0,.05);display:flex;margin-bottom:16rpx;padding:20rpx}.recommend-emoji-wrap{align-items:center;border-radius:18rpx;display:flex;flex-shrink:0;height:72rpx;justify-content:center;margin-right:18rpx;width:72rpx}.recommend-emoji{font-size:36rpx}.recommend-copy{flex:1;min-width:0}.recommend-name{color:#1a2e1c;display:block;font-size:26rpx;font-weight:700;margin-bottom:6rpx}.recommend-desc{color:#7a9e7f;display:block;font-size:22rpx;line-height:1.5}.recommend-tag{font-size:22rpx;font-weight:700;margin-left:12rpx}
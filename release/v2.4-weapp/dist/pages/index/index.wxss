.index-container{background:linear-gradient(160deg,#ffe5ec,#fff0d6 50%,#e5f3ff);min-height:100vh;overflow:hidden;padding-bottom:120rpx;position:relative}.fireworks-overlay{inset:0;pointer-events:none;position:fixed;z-index:999}.fireworks-mask{animation:fireworks-fade 3s ease-out forwards;background:radial-gradient(circle at center,hsla(0,0%,100%,.12) 0,rgba(20,16,36,.24) 100%);inset:0;position:absolute}.firework-burst{height:36rpx;margin-left:-18rpx;margin-top:-18rpx;position:absolute;width:36rpx}.firework-core{animation:firework-core-pop .8s ease-out var(--firework-delay) both;background:var(--firework-color);border-radius:50%;box-shadow:0 0 24rpx var(--firework-color);height:20rpx;left:50%;margin-left:-10rpx;margin-top:-10rpx;position:absolute;top:50%;width:20rpx}.firework-particle{animation:firework-particle-burst 1s ease-out var(--firework-delay) both;background:linear-gradient(180deg,hsla(0,0%,100%,.95) 0,var(--firework-color) 55%,hsla(0,0%,100%,0) 100%);border-radius:999rpx;height:48rpx;left:50%;margin-left:-4rpx;margin-top:-24rpx;opacity:0;position:absolute;top:50%;transform-origin:center center;width:8rpx}.particle-1{transform:rotate(0deg) translateY(-12rpx)}.particle-2{transform:rotate(45deg) translateY(-12rpx)}.particle-3{transform:rotate(90deg) translateY(-12rpx)}.particle-4{transform:rotate(135deg) translateY(-12rpx)}.particle-5{transform:rotate(180deg) translateY(-12rpx)}.particle-6{transform:rotate(225deg) translateY(-12rpx)}.particle-7{transform:rotate(270deg) translateY(-12rpx)}.particle-8{transform:rotate(315deg) translateY(-12rpx)}@keyframes fireworks-fade{0%{opacity:0}10%{opacity:1}100%{opacity:0}}@keyframes firework-core-pop{0%{opacity:0;transform:scale(.2)}30%{opacity:1;transform:scale(1.4)}100%{opacity:0;transform:scale(0)}}@keyframes firework-particle-burst{0%{height:12rpx;opacity:0}20%{opacity:1}100%{height:110rpx;opacity:0}}.top-decor{height:400rpx;left:0;pointer-events:none;position:absolute;right:0;top:0}.top-decor .decor-circle{border-radius:50%;position:absolute}.top-decor .circle-1{background:#ffd93d;height:280rpx;opacity:.35;right:-80rpx;top:-80rpx;width:280rpx}.top-decor .circle-2{background:#6bcb77;height:200rpx;left:-60rpx;opacity:.25;top:60rpx;width:200rpx}.header{padding:180rpx 48rpx 56rpx;position:relative;text-align:center;z-index:1}.header .header-title{color:#5a4a4a;display:block;font-size:56rpx;font-weight:800;letter-spacing:2rpx;margin-bottom:16rpx}.header .header-subtitle{color:#7a5a6a;display:block;font-size:30rpx;letter-spacing:4rpx}.cards-section{margin-bottom:48rpx;padding:0 32rpx;position:relative;z-index:1}.section-block{margin-bottom:40rpx;padding:0 32rpx;position:relative;z-index:1}.section-heading{align-items:baseline;display:flex;gap:16rpx;justify-content:space-between;margin-bottom:20rpx}.section-title{color:#5a4a4a;font-size:34rpx;font-weight:800}.section-desc{color:#8a7a8a;font-size:22rpx}.cards-row-1{display:flex;gap:20rpx;margin-bottom:20rpx}.cards-row-2{display:flex;gap:20rpx;justify-content:center}.func-card{align-items:center;backdrop-filter:blur(8rpx);border:2rpx solid;border-radius:24rpx;box-sizing:border-box;display:flex;flex:none;flex-direction:column;justify-content:center;min-height:200rpx;padding:28rpx 20rpx 24rpx;transition:transform .25s ease,box-shadow .25s ease;width:calc(33.33333% - 40rpx/3)}.func-card:active{transform:scale(.96)}.func-card-placeholder{flex:1;visibility:hidden}.card-emoji{font-size:52rpx;line-height:1;margin-bottom:16rpx}.card-title{font-size:32rpx;font-weight:700;letter-spacing:1rpx;margin-bottom:10rpx}.card-desc{color:#7a5a6a;font-size:24rpx;line-height:1.4;text-align:center}.hot-test-list{display:flex;flex-direction:column;gap:16rpx}.hot-test-card{background:hsla(0,0%,100%,.82);border:2rpx solid hsla(0,0%,100%,.8);border-radius:24rpx;box-shadow:0 10rpx 24rpx rgba(122,90,106,.06);padding:24rpx 24rpx 22rpx}.hot-test-card:active{transform:scale(.98)}.hot-test-top{align-items:center;display:flex;justify-content:space-between;margin-bottom:14rpx}.hot-test-emoji{font-size:46rpx;line-height:1}.hot-test-tag{border-radius:999rpx;font-size:22rpx;font-weight:700;padding:8rpx 18rpx}.hot-test-title{color:#4f3e4c;display:block;font-size:32rpx;font-weight:800;margin-bottom:8rpx}.hot-test-desc{color:#7a5a6a;display:block;font-size:24rpx;line-height:1.6}.topic-grid{display:grid;gap:16rpx;grid-template-columns:repeat(2,minmax(0,1fr))}.topic-card{background:linear-gradient(135deg,hsla(0,0%,100%,.92),rgba(255,245,248,.92));border-radius:24rpx;box-shadow:0 8rpx 20rpx rgba(77,150,255,.08);display:flex;flex-direction:column;justify-content:space-between;min-height:160rpx;padding:24rpx 22rpx}.topic-card:active{transform:scale(.98)}.topic-title{color:#4f3e4c;font-size:30rpx;font-weight:800;margin-bottom:10rpx}.topic-desc{color:#7a5a6a;font-size:24rpx;line-height:1.5}.topic-arrow{color:#ff6b9d;font-size:24rpx;font-weight:700}.sbti-section{padding:0 32rpx;position:relative;z-index:1}.page-footer{padding:36rpx 32rpx 0;position:relative;text-align:center;z-index:1}.footer-text{color:#9a8a95;font-size:22rpx;letter-spacing:1rpx}.sbti-card{background:linear-gradient(135deg,#ff6b9d,#ff8e8e);border-radius:32rpx;box-shadow:0 12rpx 40rpx rgba(255,107,157,.35);overflow:hidden;padding:40rpx 36rpx 36rpx;position:relative}.sbti-card .sbti-decor{border-radius:50%;position:absolute}.sbti-card .sbti-decor.sbti-decor-left{background:hsla(0,0%,100%,.12);bottom:-60rpx;height:180rpx;left:-60rpx;width:180rpx}.sbti-card .sbti-decor.sbti-decor-right{background:hsla(0,0%,100%,.1);height:140rpx;right:-40rpx;top:-40rpx;width:140rpx}.sbti-card-content{align-items:flex-start;display:flex;gap:24rpx;margin-bottom:36rpx;position:relative;z-index:1}.sbti-icon{flex-shrink:0;font-size:64rpx;line-height:1}.sbti-text-group{flex:1}.sbti-title{color:#fff;display:block;font-size:40rpx;font-weight:800;letter-spacing:2rpx;margin-bottom:12rpx}.sbti-desc{color:hsla(0,0%,100%,.85);display:block;font-size:28rpx;line-height:1.6;margin-bottom:20rpx}.sbti-tags{display:flex;flex-wrap:wrap;gap:12rpx}.sbti-tag{background:hsla(0,0%,100%,.22);border-radius:50rpx;color:#fff;font-size:22rpx;letter-spacing:1rpx;padding:6rpx 18rpx}.sbti-btn{background:hsla(0,0%,100%,.95)!important;border:none!important;border-radius:50rpx!important;box-shadow:0 8rpx 24rpx rgba(0,0,0,.12);color:#ff6b9d!important;font-size:36rpx!important;font-weight:700!important;height:100rpx;letter-spacing:3rpx;line-height:100rpx;position:relative;width:100%;z-index:1}.sbti-btn::after{border:none!important}.sbti-btn:active{transform:scale(.97)}
.student-tendency-page{background:linear-gradient(160deg,#eef3ff,#f8f2ff 55%,#fff8ef);box-sizing:border-box;min-height:100vh;padding:40rpx 28rpx calc(56rpx + env(safe-area-inset-bottom))}.disclaimer-card,.intro-card,.question-card,.result-card{background:hsla(0,0%,100%,.92);border-radius:32rpx;box-shadow:0 12rpx 40rpx rgba(73,89,181,.08)}.intro-card{margin-top:100rpx;padding:64rpx 40rpx 48rpx;text-align:center}.intro-badge{background:rgba(91,124,250,.12);border-radius:999rpx;color:#5b7cfa;display:inline-block;font-size:24rpx;font-weight:700;margin-bottom:24rpx;padding:10rpx 22rpx}.intro-emoji{display:block;font-size:96rpx;margin-bottom:12rpx}.intro-title{color:#2d3258;display:block;font-size:44rpx;font-weight:800;margin-bottom:16rpx}.axis-range,.disclaimer-text,.guide-text,.intro-desc,.intro-note,.option-text,.result-summary{color:#67708f;font-size:28rpx;line-height:1.75}.intro-tags{display:flex;flex-wrap:wrap;gap:12rpx;justify-content:center;margin:28rpx 0 24rpx}.intro-tag{background:#f3f5ff;border-radius:999rpx;color:#5b6aa8;font-size:22rpx;padding:8rpx 18rpx}.intro-note{margin:0 0 32rpx}.next-btn.active,.primary-btn,.start-btn{background:linear-gradient(135deg,#5b7cfa,#7e69ff);color:#fff}.start-btn{border-radius:46rpx;font-size:32rpx!important;font-weight:700!important;height:92rpx;line-height:92rpx;width:100%}.start-btn::after{border:none!important}.test-header{align-items:center;display:flex;justify-content:space-between;padding:12rpx 4rpx 20rpx}.header-title{color:#2d3258;font-size:34rpx;font-weight:800}.header-count{color:#7b84a5;font-size:26rpx}.progress-bar{background:rgba(91,124,250,.12);border-radius:999rpx;height:10rpx;margin-bottom:24rpx;overflow:hidden}.progress-fill{background:linear-gradient(135deg,#5b7cfa,#7e69ff);height:100%}.question-scroll,.result-scroll{height:calc(100vh - 280rpx)}.question-card{margin-bottom:20rpx;padding:40rpx 32rpx}.question-note{color:#8d95b0;display:block;font-size:24rpx;margin-bottom:12rpx}.question-text{color:#2f3556;font-size:40rpx;font-weight:700;line-height:1.55}.disclaimer-card{margin-bottom:20rpx;padding:24rpx 28rpx}.options-list{display:flex;flex-direction:column;gap:18rpx}.option-item{align-items:flex-start;background:hsla(0,0%,100%,.92);border:2rpx solid transparent;border-radius:28rpx;box-shadow:0 8rpx 24rpx rgba(73,89,181,.06);display:flex;gap:20rpx;padding:28rpx 26rpx}.option-item.selected{background:rgba(91,124,250,.08);border-color:#5b7cfa}.option-index{align-items:center;background:#edf1ff;border-radius:50%;color:#6b7394;display:flex;flex-shrink:0;font-size:24rpx;font-weight:700;height:54rpx;justify-content:center;width:54rpx}.option-index.selected{background:#5b7cfa;color:#fff}.bottom-actions,.result-actions{display:flex;gap:20rpx;margin-top:24rpx}.back-btn,.next-btn,.primary-btn,.secondary-btn{align-items:center;border-radius:44rpx;display:flex;font-size:30rpx;font-weight:700;height:88rpx;justify-content:center}.back-btn,.secondary-btn{background:hsla(0,0%,100%,.9);color:#5f6785;flex:1}.next-btn,.primary-btn{flex:1.4}.next-btn.disabled{background:#dfe4f2;color:#98a0bc}.result-card{padding:52rpx 36rpx 44rpx}.result-label{color:#8d95b0;display:block;font-size:24rpx;margin-bottom:14rpx;text-align:center}.result-title{color:#2d3258;display:block;font-size:48rpx;font-weight:800;margin-bottom:16rpx;text-align:center}.result-subtitle{color:#5b6aa8;display:block;font-size:28rpx;line-height:1.6;margin-bottom:20rpx;text-align:center}.axis-list{display:flex;flex-direction:column;gap:16rpx;margin:28rpx 0}.axis-card,.guide-card{background:#f7f8ff;border-radius:24rpx;padding:22rpx 24rpx}.axis-head{display:flex;gap:20rpx;justify-content:space-between;margin-bottom:8rpx}.axis-name{color:#8d95b0;font-size:24rpx}.axis-dominant{color:#5b7cfa;font-size:24rpx;font-weight:700}.guide-title{color:#36406d;display:block;font-size:26rpx;font-weight:700;margin-bottom:8rpx}.result-note{color:#9ca3bf;display:block;font-size:22rpx;margin-top:28rpx;text-align:center}.share-result-btn{background:#5b7cfa;border:none;border-radius:44rpx;color:#fff;flex:1.4;font-size:30rpx;font-weight:700;height:88rpx;line-height:88rpx}.share-result-btn::after{border:none}.result-back-row{align-items:center;display:flex;justify-content:center;padding:20rpx 0 8rpx}.result-back-text{color:#5b7cfa;font-size:26rpx;text-decoration:underline}